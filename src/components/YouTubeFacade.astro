---
/**
 * Click-to-load YouTube player with chapter links.
 *
 * With a video ID it shows a poster and a play button; the player
 * (youtube-nocookie.com) loads only after a click. Chapter links start the
 * player at their timestamp. Without JavaScript, the links open YouTube.
 *
 * Without a video ID it shows the gray placeholder from the design.
 */
import YouTubePlayerScript from './YouTubePlayerScript.astro';
import { timestampToSeconds } from '../lib/projects';

interface Props {
  videoId?: string | undefined;
  /** Used for the player's accessible name. */
  title: string;
  chapters?: { title: string; start?: string | undefined }[];
  /** Length shown on the placeholder when there is no video yet. */
  duration?: string | undefined;
  /** Custom poster. Defaults to YouTube's thumbnail for the video. */
  poster?: string | undefined;
}

const { videoId, title, chapters = [], poster, duration = '[DURATION]' } = Astro.props;

const posterSrc = poster ?? (videoId ? `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg` : undefined);
const watchUrl = (seconds = 0) =>
  `https://www.youtube.com/watch?v=${videoId}${seconds > 0 ? `&t=${seconds}s` : ''}`;

const playIcon = 'M8 5.5v13l11-6.5z';
---

{
  videoId ? (
    <div class="flex flex-col gap-4" data-yt-id={videoId} data-yt-title={`${title} walkthrough`}>
      <div class="relative aspect-video overflow-hidden rounded-xl bg-tile" data-yt-frame>
        <a
          href={watchUrl()}
          class="group absolute inset-0 flex items-center justify-center"
          aria-label="Play narrated walkthrough"
          data-yt-start="0"
        >
          <img
            src={posterSrc}
            alt=""
            width="480"
            height="360"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
          />
          <span class="relative flex h-14 w-14 items-center justify-center rounded-full bg-ink">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#FFFFFF" aria-hidden="true">
              <path d={playIcon} />
            </svg>
          </span>
        </a>
      </div>
      {chapters.length > 0 && (
        <nav aria-label="Chapters" class="flex flex-wrap gap-x-5">
          {chapters.map((chapter) => {
            const seconds = chapter.start ? timestampToSeconds(chapter.start) : 0;
            return (
              <a
                href={watchUrl(seconds)}
                class="-my-px inline-flex min-h-11 items-center text-muted hover:text-ink"
                data-yt-start={seconds}
              >
                {chapter.title}
              </a>
            );
          })}
        </nav>
      )}
      <YouTubePlayerScript />
    </div>
  ) : (
    <div class="flex flex-col gap-4">
      <div
        class="relative flex aspect-video items-center justify-center overflow-hidden rounded-xl bg-tile"
        role="img"
        aria-label="Narrated walkthrough video, not recorded yet"
      >
        <span class="flex h-14 w-14 items-center justify-center rounded-full bg-ink" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#FFFFFF">
            <path d={playIcon} />
          </svg>
        </span>
        <span class="absolute right-4 bottom-3 text-[13px] text-muted" aria-hidden="true">{duration}</span>
      </div>
      {chapters.length > 0 && (
        <ul aria-label="Chapters" class="flex flex-wrap gap-x-5">
          {chapters.map((chapter) => (
            <li class="-my-px inline-flex min-h-11 items-center text-muted">{chapter.title}</li>
          ))}
        </ul>
      )}
    </div>
  )
}
