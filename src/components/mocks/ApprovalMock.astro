---
/** Mock for OpenClaw Deployment: an outbound email waiting on approval, with a run log. */
---

<div aria-hidden="true" class="absolute inset-0 flex items-center gap-3.5 px-9 py-8">
  <div
    class="flex min-w-0 flex-[1_1_60%] flex-col gap-[9px] rounded-[10px] bg-white p-3.5 text-[11px] leading-[1.4] shadow-card"
  >
    <div class="flex justify-between text-muted">
      <span>Outbound email</span><span class="text-warn">Needs approval</span>
    </div>
    <span class="text-[12px] font-medium text-ink">Re: onboarding documents</span>
    <div class="h-[5px] w-full rounded-[3px] bg-rule"></div>
    <div class="h-[5px] w-4/5 rounded-[3px] bg-rule"></div>
    <div class="mt-0.5 flex gap-1.5">
      <span class="rounded-md bg-ink px-[9px] py-1 text-white">Approve</span>
      <span class="rounded-md border border-edge px-[9px] py-[3px] text-ink">Edit</span>
    </div>
  </div>
  <div class="flex min-w-0 flex-[1_1_40%] flex-col gap-[7px] text-[10px] leading-[1.3] text-muted">
    <span>09:41 read inbox</span>
    <span>09:41 drafted reply</span>
    <span class="text-warn">09:42 waiting on human</span>
    <span class="text-ink">09:44 approved, sent</span>
  </div>
</div>
