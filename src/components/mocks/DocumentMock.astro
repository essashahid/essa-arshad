---
/** Mock for EvidenceOps: a source document beside the fields extracted from it. */
---

<div aria-hidden="true" class="absolute inset-0 flex items-center gap-3 px-8 py-[30px]">
  <div class="flex min-w-0 flex-[1_1_48%] flex-col gap-1.5 rounded-lg bg-white p-3 shadow-card">
    <span class="text-[10px] text-muted">contract.pdf, page 3</span>
    <div class="h-[5px] w-full rounded-[3px] bg-rule"></div>
    <div class="h-[5px] w-[90%] rounded-[3px] bg-rule"></div>
    <div class="h-2 w-[70%] rounded-[3px] bg-highlight"></div>
    <div class="h-[5px] w-[94%] rounded-[3px] bg-rule"></div>
    <div class="h-[5px] w-[76%] rounded-[3px] bg-rule"></div>
  </div>
  <div class="flex min-w-0 flex-[1_1_52%] flex-col gap-2 rounded-lg bg-white p-3 text-[11px] leading-[1.4] shadow-card">
    <div class="flex justify-between"><span>Effective date</span><span class="text-muted">p.3</span></div>
    <div class="flex justify-between"><span>Counterparty</span><span class="text-muted">p.1</span></div>
    <div class="flex justify-between"><span>Renewal term</span><span class="text-warn">Review</span></div>
  </div>
</div>
