---
/** Mock for PSX Research Copilot: a question bubble and a sourced answer. */
---

<div aria-hidden="true" class="absolute inset-0 flex items-center px-12 py-[30px]">
  <div class="flex w-full flex-col gap-[9px] rounded-[10px] bg-white p-3.5 text-[11px] leading-[1.45] shadow-card">
    <span class="font-medium">Research Copilot</span>
    <div class="max-w-[80%] self-end rounded-[10px_10px_2px_10px] bg-ink px-2.5 py-[7px] text-white">
      Which of my holdings raised their dividend this year?
    </div>
    <div class="flex w-4/5 flex-col gap-[5px] self-start rounded-[10px_10px_10px_2px] bg-bubble p-[9px]">
      <div class="h-[5px] w-full rounded-[3px] bg-skeleton"></div>
      <div class="h-[5px] w-[86%] rounded-[3px] bg-skeleton"></div>
      <span class="text-[10px] text-muted">2 sources</span>
    </div>
  </div>
</div>
