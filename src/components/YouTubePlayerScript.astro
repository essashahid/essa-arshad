---
/**
 * Behavior for YouTubeFacade. Kept in its own component so the script only
 * ships on pages that actually have a walkthrough video.
 */
---

<script>
  document.querySelectorAll<HTMLElement>('[data-yt-id]').forEach((root) => {
    const frame = root.querySelector<HTMLElement>('[data-yt-frame]');
    const id = root.dataset.ytId;
    if (!frame || !id) return;

    const play = (start: number) => {
      const iframe = document.createElement('iframe');
      const params = new URLSearchParams({ autoplay: '1', rel: '0', start: String(start) });
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?${params}`;
      iframe.title = root.dataset.ytTitle ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 h-full w-full border-0';
      frame.replaceChildren(iframe);
      iframe.focus();
      frame.scrollIntoView({ block: 'nearest' });
    };

    root.addEventListener('click', (event) => {
      const link = (event.target as Element).closest<HTMLElement>('[data-yt-start]');
      if (!link) return;
      event.preventDefault();
      play(Number(link.dataset.ytStart) || 0);
    });
  });
</script>
