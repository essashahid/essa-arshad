---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { withBase } from '../lib/paths';
---

<BaseLayout title={`Page not found — ${site.name}`} description="This page does not exist." noindex>
  <main id="main" class="mx-auto flex max-w-[600px] flex-col gap-4 px-6 pt-28">
    <a href={withBase('/')} class="self-start py-2.5 text-muted hover:text-ink">← Index</a>
    <div>
      <h1 class="text-[15px] leading-normal font-medium">Page not found</h1>
      <p class="text-muted">404</p>
    </div>
    <p>There is nothing at this address. Head back to the <a href={withBase('/')} class="link">index</a>.</p>
  </main>
  <Footer class="max-w-[600px]" />
</BaseLayout>
